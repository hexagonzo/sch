<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>sch</AssemblyName><LangVersion>latest</LangVersion>
    <GameDataDir Condition="'$(GameDataDir)'==''">$(STS2_DATA_DIR)</GameDataDir>
  </PropertyGroup>
  <Target Name="VerifyGameAssemblies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(GameDataDir)/sts2.dll')" Text="Pass -p:GameDataDir=PATH_TO_GAME_DATA_DIRECTORY (contains sts2.dll)" />
  </Target>
  <ItemGroup>
    <Reference Include="sts2"><HintPath>$(GameDataDir)/sts2.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="GodotSharp"><HintPath>$(GameDataDir)/GodotSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(GameDataDir)/0Harmony.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
